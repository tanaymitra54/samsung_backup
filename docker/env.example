# Copy to samsung_backup/.env and fill in. Do not commit secrets.
#   cp docker/env.example .env

# Hugging Face (optional but recommended for downloads)
HF_TOKEN=
HF_HOME=/workspace/cache/huggingface
TRANSFORMERS_CACHE=/workspace/cache/models
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1

# Which host GPUs the container may see (comma-separated)
CUDA_VISIBLE_DEVICES=0,1

# Optional experiment tracking
WANDB_API_KEY=
WANDB_MODE=online

# PyTorch allocator (optional; only helps fragmentation, not a full GPU)
# PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
